{
  "schema_version": "1.0",
  "adapter": "claude-code",
  "target_skill_root": ".claude/skills",
  "staging": {
    "required": true,
    "candidate_roots": [
      ".claude/skills"
    ]
  },
  "skills_cli": {
    "command": "npx",
    "package": "skills",
    "agent": "claude-code",
    "copy_mode": true,
    "yes": true,
    "global": false,
    "disable_telemetry_env": "DISABLE_TELEMETRY"
  },
  "post_install": [
    "discovery.scan",
    "registry.build",
    "registry.verify",
    "acquisition.record",
    "acquisition.verify"
  ]
}
