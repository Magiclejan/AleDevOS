{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aledevos.local/schemas/skill-execution-handoff-request.schema.json",
  "title": "AleDevOS Skill Execution Handoff Request",
  "type": "object",
  "required": ["schema_version", "task_id", "target_agent", "input_refs", "required_outputs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "target_agent": {"type": "string", "minLength": 1},
    "input_refs": {"type": "array", "items": {"type": "object", "required": ["kind", "ref"], "properties": {"kind": {"type": "string"}, "ref": {"type": "string"}, "sha256": {"type": "string"}}, "additionalProperties": false}},
    "required_outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "optional_outputs": {"type": "array", "items": {"type": "string"}},
    "max_output_tokens": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
