{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aledevos.local/schemas/skill-binding.schema.json",
  "title": "AleDevOS Runtime Skill Binding 1.0",
  "type": "object",
  "required": ["schema_version","adapter","binding_version","bindings"],
  "properties": {
    "schema_version": {"const":"1.0"},
    "adapter": {"type":"string","minLength":1},
    "binding_version": {"type":"string","minLength":1},
    "bindings": {
      "type":"array",
      "items": {
        "type":"object",
        "required":["skill_id","path","expected_sha256"],
        "properties": {
          "skill_id":{"type":"string"},
          "path":{"type":"string"},
          "expected_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
