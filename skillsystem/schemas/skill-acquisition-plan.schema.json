{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aledevos://skillsystem/skill-acquisition-plan.schema.json",
  "title": "Skill Acquisition Plan",
  "type": "object",
  "required": ["schema_version", "skill_id", "adapter", "status", "approval_required", "integrity"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "skill_id": {"type": "string"},
    "adapter": {"type": "string"},
    "status": {"enum": ["ALREADY_AVAILABLE", "ACQUISITION_AUTO_APPROVED", "ACQUISITION_APPROVAL_REQUIRED", "ACQUISITION_SOURCE_RESOLUTION_REQUIRED"]},
    "source": {"type": ["object", "null"]},
    "approval_required": {"type": "boolean"},
    "reason": {"type": "string"},
    "created_at": {"type": "string"},
    "integrity": {
      "type": "object",
      "required": ["algorithm", "payload_sha256"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
