{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aledevos.local/schemas/skill-descriptor.schema.json",
  "title": "AleDevOS Skill Descriptor 1.0",
  "type": "object",
  "required": ["schema_version","id","domain","role","description","source_kind","provenance","capabilities","intents","dependencies","conflicts","context_loading","trust","declared_status"],
  "properties": {
    "schema_version": {"const":"1.0"},
    "id": {"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},
    "display_name": {"type":"string"},
    "domain": {"type":"string","minLength":1},
    "role": {"type":"string","minLength":1},
    "description": {"type":"string"},
    "source_kind": {"enum":["bundled-core","external-declared","runtime-discovered"]},
    "provenance": {"type":"string","minLength":1},
    "instruction_ref": {"type":["string","null"]},
    "instruction_sha256": {"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},
    "capabilities": {"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"}},
    "intents": {"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"}},
    "dependencies": {"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "conflicts": {"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "context_loading": {"enum":["on-demand","always","never"]},
    "trust": {"enum":["bundled","declared-unverified","runtime-verified"]},
    "declared_status": {"enum":["BUNDLED","DECLARED_UNRESOLVED","DISCOVERED"]}
  },
  "additionalProperties": false
}
