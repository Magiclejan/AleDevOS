  "reasoning": {
    "LOW": {
      "relative_budget": 0.25
    },
    "MEDIUM": {
      "relative_budget": 0.55
    },
    "HIGH": {
      "relative_budget": 1
    },
    "role_overrides": {
      "architect": "HIGH",
      "auditor": "HIGH",
      "judge-requirements": "MEDIUM",
      "judge-regression": "MEDIUM",
      "judge-quality": "MEDIUM",
      "verifier": "LOW",
      "visual-capture-runner": "LOW",
      "visual-regression-runner": "LOW",
      "visual-runtime-audit-runner": "LOW"
    }
  },
  "response_budgets": {
    "closed_decision_max_tokens": 120,
    "handoff_max_tokens": 600,
    "research_summary_max_tokens": 1400,
    "architecture_summary_max_tokens": 1800,
    "implementation_handoff_max_tokens": 1200,
    "judge_max_tokens": 700,
    "user_progress_update_max_tokens": 180,
    "user_final_default_max_tokens": 1200,
    "hard_rule": "REQUIRED_EVIDENCE_MAY_EXCEED_BUDGET"
  },
  "compact_technical_language": {
    "name": "ACTL_1_0",
    "inspired_by": [
      "controlled_technical_language",
      "structured_decision_contracts"
    ],
    "rules": [
      "one_semantic_action_per_sentence",
      "use_one_canonical_term_per_concept",
      "prefer_direct_active_instructions",
      "remove_repeated_background",
      "reference_unchanged_evidence_by_id_or_hash",
      "prefer_tables_or_structured_fields_for_repeated_dimensions",
      "do_not_repeat_tool_output_verbatim_when_a_status_and_reference_are_sufficient",
      "do_not_hide_uncertainty",
      "do_not_compress_required_evidence"
    ]
  },
  "closed_decision_contracts": {
    "TASK_PROFILE": [
      "MICRO",
      "STANDARD",
      "DEEP",
      "CRITICAL"
    ],
    "BOOLEAN_NEED": [
      "YES",
      "NO"
    ],
    "ROUTING_ACTION": [
      "USE",
      "SKIP",
      "DEFER",
      "BLOCK"
    ],
    "EFFICIENCY_RESULT": [
      "PASS",
      "BLOCKED",
      "FAIL"
    ]
  },
  "user_intervention": {
    "allowed_reasons": [
      "AMBIGUOUS_PRODUCT_DECISION",
      "MISSING_AUTHORITY",
      "EXTERNAL_SECRET_OR_CREDENTIAL",
      "IRREVERSIBLE_ACTION_APPROVAL",
      "POLICY_EXCEPTION_APPROVAL"
    ],
    "forbidden_operational_requests": [
      "CHOOSE_AGENT",
      "CHOOSE_NEXT_STEP",
      "MANUALLY_COORDINATE_WORKERS",
      "MANUALLY_SELECT_SKILLS",
      "MANUALLY_SELECT_TEST_ORDER",
      "REPEAT_KNOWN_CONTEXT"
    ]
  },
  "quality_preservation": {
    "candidate_final_state_required": "PASS",
    "required_gates": [
      "scope",
      "integrity",
      "canonical"
    ],
    "required_judges": [
      "requirements",
      "regression",
      "quality"
    ],
    "minimum_judge_score": 90,
    "maximum_judge_score_drop": 2,
    "maximum_new_blockers": 0,
    "maximum_new_unverified": 0,
    "acceptance_all_verified": true,
    "repairs_may_not_increase": true
  },
  "required_benchmark_measurements": [
    "input_tokens",
    "output_tokens",
    "context_peak",
    "tool_calls",
    "files_read",
    "handoff_tokens",
    "model_calls",
    "active_agents"
  ]
}
