      ],
      "auditor_signals": [
        "cross_domain",
        "unknown_requirements"
      ],
      "verifier_default": false
    }
  },
  "skill_activation": {
    "always": [
      "task-contract"
    ],
    "write_task": [
      "safe-edit",
      "test-strategy",
      "requirements-check",
      "regression-analysis",
      "diff-review"
    ],
    "STANDARD_plus": [
      "repo-map",
      "implementation-plan"
    ],
    "security_sensitive": [
      "security-check"
    ],
    "frontend": [
      "frontend-change"
    ],
    "backend": [
      "backend-change"
    ],
    "database": [
      "database-change"
    ],
    "repair": [
      "repair-loop"
    ]
