{
  "schema_version": "1.0",
  "phase": "GLOBAL_EFFICIENCY_P7",
  "principles": [
    "user_is_goal_owner_not_project_manager",
    "minimum_necessary_intelligence",
    "quality_before_token_savings",
    "required_evidence_is_never_truncated",
    "closed_decisions_before_freeform_prose",
    "context_relevance_before_context_size",
    "delta_handoffs_before_repeated_context",
    "read_on_demand_before_full_file",
    "specialist_only_when_signal_requires_it",
    "reasoning_effort_matches_risk",
    "unknown_measurements_remain_unknown",
    "optimization_requires_comparable_baseline",
    "no_gate_or_security_bypass_for_efficiency"
  ],
