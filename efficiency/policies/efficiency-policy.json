  "scoring": {
    "risk": {
      "LOW": 0,
      "MEDIUM": 2,
      "HIGH": 4
    },
    "type": {
      "QUESTION": 0,
      "AUDIT": 1,
      "BUGFIX": 1,
      "FEATURE": 2,
      "REFACTOR": 2,
      "MAINTENANCE": 1,
      "SYSTEM_TEST": 3
    },
    "scope_per_three_paths": 1,
    "scope_max": 3,
    "acceptance_per_four": 1,
    "acceptance_max": 2,
    "signals": {
      "cross_domain": 2,
      "security_sensitive": 4,
      "database_affecting": 2,
      "external_integration": 2,
      "ui_affecting": 1,
      "unknown_requirements": 2,
      "migration_or_destructive": 5,
      "multi_machine": 3,
      "requires_research": 1,
      "knowledge_stale": 1
    },
    "minimum_profile_by_risk": {
      "LOW": "MICRO",
      "MEDIUM": "STANDARD",
      "HIGH": "DEEP"
    },
    "force_critical_signals": [
      "security_sensitive",
      "migration_or_destructive"
    ]
  },
  "agent_activation": {
