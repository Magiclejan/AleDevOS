{
  "schema_version": "1.0",
  "phase": "ADVANCED_EXECUTION_P1_WORKTREES",
  "git_min_version": "2.20.0",
  "branch_prefix": "aledevos/task/",
  "worktree_container": ".aledevos-worktrees",
  "location": "SIBLING_OF_REPOSITORY",
  "max_task_id_length": 64,
  "max_registered_task_worktrees": 32,
  "rules": {
    "require_primary_checkout": true,
    "require_attached_primary_branch": true,
    "require_clean_primary": true,
    "require_pinned_base_commit": true,
    "require_base_ref_unchanged_at_create": true,
    "require_primary_head_unchanged_at_create": true,
    "derive_branch_name": true,
    "derive_worktree_path": true,
    "allow_user_supplied_branch": false,
    "allow_user_supplied_worktree_path": false,
    "allow_existing_branch_reuse": false,
    "allow_existing_target_path": false,
    "allow_detached_task_worktree": false,
    "allow_force_remove": false,
    "cleanup_requires_clean_worktree": true,
    "cleanup_deletes_branch": false,
    "network_used": false,
    "worker_execution_enabled": false,
    "concurrency_enabled": false,
    "dispatcher_enabled": false,
    "queue_enabled": false,
    "multi_machine_enabled": false
  }
}
