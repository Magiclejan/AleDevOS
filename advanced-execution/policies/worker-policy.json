{
  "schema_version": "1.0",
  "phase": "ADVANCED_EXECUTION_P2_ISOLATED_WORKERS",
  "worker_id_prefix": "worker-",
  "heartbeat_interval_ms": 250,
  "heartbeat_timeout_ms": 2500,
  "start_timeout_ms": 5000,
  "stop_timeout_ms": 5000,
  "max_recovery_count": 1,
  "max_read_scopes": 64,
  "max_write_scopes": 32,
  "max_scope_length": 240,
  "roles": {
    "read_only": [
      "architect",
      "researcher",
      "auditor",
      "verifier",
      "judge-requirements",
      "judge-regression",
      "judge-quality",
      "judge-uxui",
      "design-system-guardian",
      "motion-director",
      "visual-judge",
      "v1-release-validator"
    ],
    "product_writer": [
      "builder",
      "editor-frontend",
      "editor-backend",
      "editor-database",
      "editor-tests",
      "editor-config",
      "repairer"
    ]
  },
  "always_protected_paths": [
    ".git",
    ".git/**",
    ".aledevos",
    ".aledevos/**"
  ],
  "environment_allowlist": [
    "PATH",
    "Path",
    "PATHEXT",
    "SYSTEMROOT",
    "SystemRoot",
    "WINDIR",
    "TEMP",
    "TMP",
    "TMPDIR",
    "HOME",
    "USERPROFILE",
    "COMSPEC"
  ],
  "rules": {
    "require_p1_worktree_receipt": true,
    "require_live_p1_worktree": true,
    "require_task_contract": true,
    "require_task_id_match": true,
    "require_clean_worktree_at_provision": true,
    "derive_worker_id": true,
    "canonical_state_paths": true,
    "one_worker_per_worktree": true,
    "one_worktree_per_worker": true,
    "read_scope_default_all": true,
    "write_scope_must_be_task_in_scope": true,
    "read_only_role_write_forbidden": true,
    "product_writer_requires_write_scope": true,
    "cross_worktree_access_allowed": false,
    "external_path_access_allowed": false,
    "symlink_escape_allowed": false,
    "arbitrary_shell_allowed": false,
    "network_used": false,
    "worker_supervisor_process_enabled": true,
    "target_agent_runtime_binding": "DEFERRED_MASTER_VALIDATION",
    "handoff_required_for_completion": true,
    "handoff_owned_by_worker": true,
    "evidence_owned_by_worker": true,
    "recovery_enabled": true,
    "concurrency_enabled": false,
    "max_active_workers": 1,
    "dispatcher_enabled": false,
    "queue_enabled": false,
    "multi_machine_enabled": false,
    "worktree_cleanup_owned_by_p1": true,
    "allow_global_write_scope": false,
    "project_protected_paths_enforced": true,
    "control_plane_mutations_serialized": true,
    "evidence_snapshotted_before_cleanup": true
  },
  "max_start_count": 2
}
