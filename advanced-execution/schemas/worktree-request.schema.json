{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aledevos.local/schemas/worktree-request.schema.json",
  "title": "AleDevOS Advanced Execution P1 Worktree Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "phase", "request_id", "task_id", "base_ref", "base_commit", "repository_identity_sha256", "primary_head_at_prepare", "primary_branch_at_prepare", "prepared_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "phase": {"const": "ADVANCED_EXECUTION_P1_WORKTREES"},
    "request_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "base_ref": {"type": "string", "minLength": 1, "maxLength": 200},
    "base_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
    "repository_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "primary_head_at_prepare": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
    "primary_branch_at_prepare": {"type": "string", "minLength": 1},
    "prepared_at": {"type": "string", "minLength": 1}
  }
}
