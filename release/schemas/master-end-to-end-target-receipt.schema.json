{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AleDevOS Master Validation P6 End-to-End Target Receipt",
  "type":"object",
  "required":["schema_version","phase","status","target","project","artifacts","claims","observed_at","receipt_sha256"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "phase":{"const":"MASTER_VALIDATION_P6_FULL_STACK_REAL_PROJECT"},
    "status":{"const":"END_TO_END_TARGET_RECEIPT_COLLECTED"},
    "target":{"type":"object"},
    "project":{"type":"object"},
    "artifacts":{"type":"array"},
    "claims":{"type":"object"},
    "observed_at":{"type":"string"},
    "receipt_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
