{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aledevos.local/schemas/target-runtime-evidence.schema.json",
  "title": "AleDevOS V1 Target Runtime Evidence",
  "type": "object",
  "required": ["schema_version", "phase", "check_id", "status", "artifacts", "observed_at", "evidence_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "phase": {"const": "ALEDEVOS_V1_FINAL_VALIDATION"},
    "check_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "BLOCKED", "FAIL"]},
    "target": {"type": "object"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "claims": {"type": "object"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "observed_at": {"type": "string", "minLength": 1},
    "validation": {"type": "object"},
    "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
