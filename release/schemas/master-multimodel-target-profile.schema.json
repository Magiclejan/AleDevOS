{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aledevos.local/schemas/master-multimodel-target-profile.schema.json",
  "title": "AleDevOS Master Validation P3 Multi-Model Target Profile",
  "type": "object",
  "required": ["schema_version","phase","target_runtime","task_id","judge_role","estimated_context_tokens","models"],
  "properties": {
    "schema_version": {"const":"1.0"},
    "phase": {"const":"MASTER_VALIDATION_P3_TARGET_PROFILE"},
    "target_runtime": {"type":"string","minLength":1},
    "task_id": {"type":"string","minLength":1},
    "judge_role": {"enum":["requirements","regression","quality","uxui","visual"]},
    "estimated_context_tokens": {"type":"integer","minimum":0},
    "max_cost_class": {"enum":["local","free","low","standard","premium","unknown"]},
    "selection_priority": {"enum":["COST_THEN_CONTEXT","CONTEXT_THEN_COST"]},
    "models": {
      "type":"object",
      "required":["primary","secondary"],
      "properties": {
        "primary":{"$ref":"#/$defs/model"},
        "secondary":{"$ref":"#/$defs/model"},
        "fallback_candidates":{"type":"array","items":{"$ref":"#/$defs/model"}}
      },
      "additionalProperties":false
    }
  },
  "$defs": {
    "model": {
      "type":"object",
      "required":["adapter","provider_id","provider_family","model_id","invocation_model_id","modalities","context_window_tokens","cost_class"],
      "properties": {
        "adapter":{"enum":["opencode","codex","claude-code","antigravity"]},
        "provider_id":{"type":"string","minLength":1},
        "provider_family":{"type":"string","minLength":1},
        "model_id":{"type":"string","minLength":1},
        "invocation_model_id":{"type":"string","minLength":1},
        "modalities":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "context_window_tokens":{"type":"integer","minimum":8193},
        "cost_class":{"enum":["local","free","low","standard","premium","unknown"]},
        "metadata_source":{"type":"string","minLength":1}
      },
      "additionalProperties":false
    }
  },
  "additionalProperties":false
}
