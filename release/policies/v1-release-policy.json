    },
    {
      "id": "real_runtime_audit",
      "description": "Real Phase 4 DOM/layout/accessibility runtime audit through the Playwright adapter."
    },
    {
      "id": "native_image_visual_judge",
      "description": "The Visual Judge actually observes sealed screenshot files through native image input."
    },
    {
      "id": "visual_fail_repair_pass",
      "description": "Controlled visual FAIL -> repair-1 -> fresh P2/P3/P4/P5 -> PASS."
    },
    {
      "id": "visual_two_repair_exhaustion",
      "description": "Controlled FAIL through repair-1 and repair-2 -> exhausted, with no third repair."
    },
    {
      "id": "full_stack_real_project",
      "description": "Full AleDevOS stack reaches final PASS on a controlled real project with deterministic gates and all three judges."
    },
    {
      "id": "security_permissions_target",
      "description": "Target adapter retains required dangerous-operation denies and role separation."
    },
    {
      "id": "deterministic_regression",
      "description": "Frozen deterministic package suite remains green before V1 freeze."
    }
