{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aledevos.multimodel.model-fallback-plan.v1",
  "type": "object",
  "required": ["schema_version", "plan_id", "task_id", "judge_role", "target_slot", "max_hops", "candidates"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "judge_role": {"enum": ["requirements", "regression", "quality", "uxui", "visual"]},
    "target_slot": {"enum": ["primary", "secondary"]},
    "max_hops": {"type": "integer", "minimum": 0, "maximum": 2},
    "candidates": {"type": "array", "minItems": 1}
  }
}
