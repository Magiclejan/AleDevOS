{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aledevos.multimodel.model-route-request.v1",
  "type": "object",
  "required": ["schema_version", "task_id", "judge_role", "estimated_context_tokens"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "judge_role": {"enum": ["requirements", "regression", "quality", "uxui", "visual"]},
    "required_modalities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "estimated_context_tokens": {"type": "integer", "minimum": 0},
    "max_cost_class": {"enum": ["local", "free", "low", "standard", "premium", "unknown"]},
    "selection_priority": {"enum": ["COST_THEN_CONTEXT", "CONTEXT_THEN_COST"]}
  },
  "additionalProperties": false
}
