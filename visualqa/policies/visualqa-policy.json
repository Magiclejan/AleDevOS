{
  "schema_version": "1.4",
  "phase1": {
    "name": "Capture Contracts + Evidence Integrity",
    "state_root": ".aledevos/state/visualqa/phase1",
    "plans_root": ".aledevos/state/visualqa/phase1/plans",
    "runs_root": ".aledevos/state/visualqa/phase1/runs",
    "artifacts_root": ".aledevos/state/visualqa/phase1/artifacts",
    "responsive_policy_path": ".aledevos/design/responsive-policy.json",
    "max_surfaces": 50,
    "max_states_per_surface": 12,
    "max_viewports_per_surface": 12,
    "max_cases": 300,
    "max_changed_files": 250,
    "task_id_pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
    "surface_id_pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
    "state_id_pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
    "allowed_protocols": [
      "http:",
      "https:"
    ],
    "default_allowed_hosts": [
      "127.0.0.1",
      "localhost",
      "::1"
    ],
    "artifact_extension": ".png",
    "require_png_signature": true,
    "require_active_responsive_policy": true,
    "evidence_reference_only": true,
    "render_execution_deferred_to_phase2": true,
    "visual_pass_claim_deferred": true,
    "evidence_id_pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
  },
  "phase2": {
    "name": "Browser Capture Runner",
    "state_root": ".aledevos/state/visualqa/phase2",
    "receipts_root": ".aledevos/state/visualqa/phase2/receipts",
    "results_root": ".aledevos/state/visualqa/phase2/results",
    "provider": "playwright",
    "allowed_browsers": [
      "chromium"
    ],
    "headless_required": true,
    "device_scale_factor": 1,
    "locale": "en-US",
    "timezone_id": "UTC",
    "color_scheme": "light",
    "reduced_motion": "reduce",
    "service_workers": "block",
    "navigation_wait_until": "domcontentloaded",
    "navigation_timeout_ms": 20000,
    "selector_timeout_ms": 8000,
    "server_probe_timeout_ms": 1500,
    "server_probe_retries": 8,
    "server_probe_delay_ms": 250,
    "wait_for_fonts": true,
    "freeze_animations": true,
    "hide_caret": true,
    "stable_ms": 120,
    "max_stable_ms": 2000,
    "fail_on_page_error": true,
    "fail_on_console_error": false,
    "non_default_state_requires_ready_selector": true,
    "route_suffix_pattern": "^[?#][^\\r\\n]*$",
    "ready_selector_max_length": 300,
    "sequential_cases": true,
    "full_page": false,
    "screenshot_scale": "css",
    "evidence_reference_only": true,
    "visual_quality_claim_deferred": true,
    "visual_regression_claim_deferred": true,
    "test_provider_subdir": ".aledevos/state/visualqa/test-providers"
  },
  "phase3": {
    "name": "Approved Baselines + Pixel Visual Regression",
    "state_root": ".aledevos/state/visualqa/phase3",
    "reports_root": ".aledevos/state/visualqa/phase3/reports",
    "diffs_root": ".aledevos/state/visualqa/phase3/diffs",
    "baselines_root": ".aledevos/visualqa/baselines",
    "baseline_id_pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
    "approval_ref_pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{2,159}$",
    "immutable_baselines": true,
    "require_phase2_receipt": true,
    "require_exact_case_set": true,
    "require_contract_match": true,
    "write_diff_for_changed_cases": true,
    "tolerance_profiles": {
      "strict": {
        "channel_threshold": 0,
        "max_diff_ratio": 0,
        "max_mean_abs_delta": 0
      },
      "browser_stable": {
        "channel_threshold": 8,
        "max_diff_ratio": 0.001,
        "max_mean_abs_delta": 4
      }
    },
    "default_tolerance_profile": "strict",
    "arbitrary_tolerance_override_forbidden": true,
    "visual_quality_claim_deferred": true,
    "rendered_layout_claim_deferred": true,
    "rendered_accessibility_claim_deferred": true,
    "baseline_auto_promotion_forbidden": true
  },
  "phase4": {
    "name": "Rendered Layout + Accessibility Runtime Checks",
    "state_root": ".aledevos/state/visualqa/phase4",
    "evidence_root": ".aledevos/state/visualqa/phase4/evidence",
    "reports_root": ".aledevos/state/visualqa/phase4/reports",
    "provider": "playwright",
    "allowed_browsers": [
      "chromium"
    ],
    "require_phase2_receipt": true,
    "phase3_report_optional_but_verified_when_present": true,
    "accessibility_policy_path": ".aledevos/design/accessibility-policy.json",
    "responsive_policy_path": ".aledevos/design/responsive-policy.json",
    "require_active_accessibility_policy": true,
    "require_active_responsive_policy": true,
    "supported_accessibility_standards": {
      "WCAG_2_2_AA": {
        "normal_text_contrast_min": 4.5,
        "large_text_contrast_min": 3.0,
        "large_text_px": 24,
        "large_bold_text_px": 18.6667,
        "bold_weight_min": 700,
        "target_size_min_px": 24,
        "layout_overflow_tolerance_px": 1,
        "max_dom_nodes": 20000,
        "max_focus_steps": 500,
        "max_samples_per_category": 200
      }
    },
    "unmeasurable_text_contrast": "BLOCKED",
    "arbitrary_threshold_override_forbidden": true,
    "full_wcag_conformance_claim_forbidden": true,
    "visual_quality_claim_deferred": true,
    "motion_quality_claim_deferred": true,
    "test_provider_subdir": ".aledevos/state/visualqa/test-providers",
    "server_probe_timeout_ms": 1500,
    "server_probe_retries": 8,
    "server_probe_delay_ms": 250
  },
  "phase5": {
    "name": "Visual Judge + Bounded Repair Loop",
    "state_root": ".aledevos/state/visualqa/phase5",
    "packets_root": ".aledevos/state/visualqa/phase5/packets",
    "submissions_root": ".aledevos/state/visualqa/phase5/submissions",
    "judgments_root": ".aledevos/state/visualqa/phase5/judgments",
    "repairs_root": ".aledevos/state/visualqa/phase5/repairs",
    "cycles_root": ".aledevos/state/visualqa/phase5/cycles",
    "acceptance_root": ".aledevos/state/visualqa/phase5/acceptance",
    "require_phase2_receipt": true,
    "require_phase3_pass": true,
    "require_phase4_pass": true,
    "observation_mode": "NATIVE_IMAGE",
    "judge_agent_id": "visual-judge",
    "required_dimensions": [
      "visual_hierarchy",
      "composition_alignment",
      "spacing_rhythm",
      "typography_readability",
      "color_brand_cohesion",
      "state_clarity",
      "responsive_consistency",
      "polish_consistency"
    ],
    "dimension_pass_score": 80,
    "case_pass_score": 80,
    "overall_pass_score": 90,
    "max_repairs": 2,
    "finding_severities": [
      "CRITICAL",
      "HIGH",
      "MEDIUM",
      "LOW"
    ],
    "critical_findings_blocking": true,
    "require_finding_for_failed_dimension": true,
    "require_actionable_finding_on_fail": true,
    "require_fresh_p2_p3_p4_after_repair": true,
    "global_run_state_path": ".aledevos/state/current.json",
    "automatic_baseline_promotion_forbidden": true,
    "scope_expansion_during_repair_forbidden": true,
    "canonical_policy_edits_during_repair_forbidden": true,
    "motion_quality_claim_forbidden": true,
    "full_wcag_conformance_claim_forbidden": true,
    "evidence_reference_only": true
  }
}
