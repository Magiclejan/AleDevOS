{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aledevos.visualqa.visual-repair-plan.v1",
  "type": "object",
  "required": ["schema_version","phase","task_id","status","attempt","max_repairs","source_judgment_path","source_judgment_file_sha256","source_judgment_sha256","pre_repair_packet_sha256","pre_repair_upstream","global_state","authorized_scope","findings","requirements","created_at","repair_plan_sha256"],
  "properties": {
    "schema_version":{"const":"1.0"},
    "phase":{"const":"VISUAL_QA_P5_REPAIR"},
    "status":{"const":"VISUAL_REPAIR_AUTHORIZED"},
    "attempt":{"type":"integer","minimum":1,"maximum":2},
    "max_repairs":{"type":"integer","minimum":1,"maximum":2},
    "authorized_scope":{"type":"array","minItems":1},
    "findings":{"type":"array","minItems":1},
    "requirements":{"type":"object"},
    "repair_plan_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
