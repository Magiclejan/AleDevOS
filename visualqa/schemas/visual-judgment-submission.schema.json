{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aledevos.visualqa.visual-judgment-submission.v1",
  "type": "object",
  "required": ["schema_version","phase","task_id","packet_sha256","judge","cases"],
  "properties": {
    "schema_version": {"const":"1.0"},
    "phase": {"const":"VISUAL_QA_P5_SUBMISSION"},
    "task_id": {"type":"string","minLength":1},
    "packet_sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "judge": {
      "type":"object",
      "required":["agent_id","model_ref","observation_mode"],
      "properties": {
        "agent_id":{"const":"visual-judge"},
        "model_ref":{"type":"string","minLength":2},
        "observation_mode":{"const":"NATIVE_IMAGE"}
      }
    },
    "cases": {"type":"array","minItems":1}
  }
}
