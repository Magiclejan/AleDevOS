{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aledevos.visualqa.visual-baseline.v1",
  "type": "object",
  "required": ["schema_version","phase","baseline_id","status","approval_ref","tolerance_profile","cases","manifest_sha256"],
  "properties": {
    "schema_version": {"const":"1.0"},
    "phase": {"const":"VISUAL_QA_P3_BASELINE"},
    "baseline_id": {"type":"string","minLength":1,"maxLength":80},
    "status": {"const":"APPROVED"},
    "approval_ref": {"type":"string","minLength":3,"maxLength":160},
    "tolerance_profile": {"type":"string","minLength":1},
    "cases": {"type":"array","minItems":1},
    "manifest_sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
