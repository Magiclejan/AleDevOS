{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aledevos.visualqa.browser-capture-receipt.v1",
  "type": "object",
  "required": [
    "schema_version",
    "phase",
    "task_id",
    "status",
    "claims",
    "plan_path",
    "plan_sha256",
    "execution_spec_path",
    "execution_spec_sha256",
    "phase1_run_path",
    "phase1_run_sha256",
    "provider",
    "determinism",
    "captures",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "phase": {
      "const": "VISUAL_QA_P2"
    },
    "task_id": {
      "type": "string"
    },
    "status": {
      "const": "BROWSER_CAPTURE_COMPLETE"
    },
    "claims": {
      "type": "object",
      "required": [
        "screenshot_capture_executed",
        "render_execution_attested",
        "visual_quality_verified",
        "visual_regression_verified"
      ],
      "properties": {
        "screenshot_capture_executed": {
          "const": true
        },
        "render_execution_attested": {
          "const": true
        },
        "visual_quality_verified": {
          "const": false
        },
        "visual_regression_verified": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "plan_path": {
      "type": "string"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "execution_spec_path": {
      "type": "string"
    },
    "execution_spec_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "phase1_run_path": {
      "type": "string"
    },
    "phase1_run_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider": {
      "type": "object"
    },
    "determinism": {
      "type": "object"
    },
    "captures": {
      "type": "array",
      "minItems": 1
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
