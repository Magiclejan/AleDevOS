{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aledevos.visualqa.visual-judge-packet.v1",
  "type": "object",
  "required": [
    "schema_version",
    "phase",
    "task_id",
    "status",
    "claims",
    "phase2_receipt_path",
    "phase2_receipt_file_sha256",
    "phase3_report_path",
    "phase3_report_file_sha256",
    "phase4_report_path",
    "phase4_report_file_sha256",
    "evidence_revision",
    "observation_mode",
    "rubric",
    "cases",
    "prepared_at",
    "packet_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "phase": {
      "const": "VISUAL_QA_P5_PACKET"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "VISUAL_JUDGE_PACKET_READY"
    },
    "claims": {
      "type": "object"
    },
    "phase2_receipt_path": {
      "type": "string"
    },
    "phase2_receipt_file_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "phase3_report_path": {
      "type": "string"
    },
    "phase3_report_file_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "phase4_report_path": {
      "type": "string"
    },
    "phase4_report_file_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observation_mode": {
      "const": "NATIVE_IMAGE"
    },
    "rubric": {
      "type": "object"
    },
    "cases": {
      "type": "array",
      "minItems": 1
    },
    "prepared_at": {
      "type": "string"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_revision": {
      "type": "string",
      "minLength": 1
    }
  }
}
