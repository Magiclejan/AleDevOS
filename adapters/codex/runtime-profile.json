{
  "schema_version": "1.0",
  "adapter": "codex",
  "runtime_family": "codex",
  "executable": "codex",
  "base_args": [
    "exec",
    "--json"
  ],
  "config_overrides": [
    "model_reasoning_effort=low"
  ],
  "role_config_overrides": {
    "orchestrator": ["features.multi_agent=true", "features.shell_tool=true"],
    "builder": ["features.multi_agent=true", "features.shell_tool=true"],
    "verifier": ["features.multi_agent=true", "features.shell_tool=true"],
    "judge-requirements": ["features.multi_agent=true", "features.shell_tool=true"],
    "judge-regression": ["features.multi_agent=true", "features.shell_tool=true"],
    "judge-quality": ["features.multi_agent=true", "features.shell_tool=true"]
  },
  "prompt_mode": "positional",
  "prompt_flag": null,
  "agent_flag": null,
  "model_flag": "--model",
  "parser": "codex-jsonl",
  "default_timeout_ms": 600000,
  "usage_fallback": {
    "enabled": false
  },
  "repo_check_bypass_flag": "--skip-git-repo-check"
}
