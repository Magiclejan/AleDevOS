{
  "schema_version": "1.0",
  "adapter": "codex",
  "runtime_family": "codex",
  "executable": "codex",
  "base_args": [
    "exec",
    "--json"
  ],
  "enable_features": [
    "multi_agent",
    "shell_tool"
  ],
  "config_overrides": [
    "model_reasoning_effort=low"
  ],
  "role_config_overrides": {
    "orchestrator": [],
    "builder": [],
    "verifier": [],
    "judge-requirements": [],
    "judge-regression": [],
    "judge-quality": []
  },
  "prompt_mode": "positional",
  "prompt_flag": null,
  "agent_flag": null,
  "model_flag": "--model",
  "parser": "codex-jsonl",
  "default_timeout_ms": 600000,
  "usage_fallback": {
    "enabled": false
  },
  "repo_check_bypass_flag": "--skip-git-repo-check"
}
