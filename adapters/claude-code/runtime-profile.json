{
  "schema_version": "1.0",
  "adapter": "claude-code",
  "runtime_family": "claude-code",
  "executable": "claude",
  "base_args": [
    "--output-format",
    "stream-json",
    "--verbose"
  ],
  "prompt_mode": "flag",
  "prompt_flag": "-p",
  "agent_flag": null,
  "model_flag": "--model",
  "parser": "claude-stream-json",
  "default_timeout_ms": 600000,
  "usage_fallback": {
    "enabled": false
  },
  "parser_module": "runtime-parser.mjs",
  "structured_output": true
}
