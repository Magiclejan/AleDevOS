{
  "aledevos-safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|write_to_file|replace_file_content|multi_replace_file_content|list_dir|find_by_name|grep_search|search_web|read_url_content|browser_.*|define_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "node .aledevos/adapters/antigravity/hooks/pretool-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
