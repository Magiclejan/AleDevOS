{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AleDevOS approved design evidence pack",
  "type":"object",
  "required":["schema_version","task_id","source_kind","artifacts"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "task_id":{"type":"string","minLength":1},
    "source_kind":{"enum":["human_approved_design_context","existing_canonical_design_system","verified_runtime_discovery","verified_skill_output"]},
    "source_ref":{"type":["string","null"]},
    "artifacts":{"type":"array","minItems":1,"items":{"type":"object","required":["section","path","sha256"],"properties":{"section":{"type":"string"},"path":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}}
  }
}
