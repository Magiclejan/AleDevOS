{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AleDevOS UX/UI Phase 3 workflow plan",
  "type":"object",
  "required":["schema_version","task_id","project_mode","workflow","stages","skill_route_requests","canonicalization","integrity_sha256"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "task_id":{"type":"string","minLength":1},
    "project_mode":{"enum":["GREENFIELD","BROWNFIELD","HYBRID"]},
    "workflow":{"enum":["DESIGN_GENESIS","DESIGN_SYSTEM_DISCOVERY","DESIGN_AUDIT_AND_CONSOLIDATE"]},
    "stages":{"type":"array","minItems":1},
    "skill_route_requests":{"type":"array"},
    "canonicalization":{"type":"object"},
    "integrity_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
