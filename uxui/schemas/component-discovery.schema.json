{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aledevos://uxui/component-discovery.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "candidate_count",
    "candidates",
    "auto_registered",
    "integrity_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "const": "DISCOVERY_COMPLETE"
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "name",
          "path",
          "source_sha256",
          "reason"
        ]
      }
    },
    "auto_registered": {
      "const": false
    },
    "integrity_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
