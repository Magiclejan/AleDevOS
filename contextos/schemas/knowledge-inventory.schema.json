{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aledevos://contextos/knowledge-inventory.schema.json",
  "title": "ContextOS Knowledge Inventory v0.5",
  "type": "object",
  "required": [
    "version",
    "source_fingerprint_sha256",
    "files",
    "integrity"
  ],
  "properties": {
    "version": {
      "const": "0.5.0"
    },
    "source_fingerprint_sha256": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "bytes",
          "sha256",
          "role"
        ]
      }
    },
    "integrity": {
      "type": "object",
      "required": [
        "algorithm",
        "payload_sha256"
      ]
    }
  }
}
