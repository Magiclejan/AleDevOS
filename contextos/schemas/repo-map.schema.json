{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aledevos://contextos/repo-map.schema.json",
  "title": "ContextOS Repo Map v0.5",
  "type": "object",
  "required": [
    "version",
    "root",
    "project",
    "source",
    "stats",
    "files",
    "integrity"
  ],
  "properties": {
    "version": {
      "const": "0.5.0"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "bytes",
          "ext",
          "role",
          "language",
          "sha256"
        ]
      }
    },
    "integrity": {
      "type": "object",
      "required": [
        "algorithm",
        "payload_sha256"
      ]
    }
  }
}
