{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aledevos://contextos/knowledge-manifest.schema.json",
  "title": "ContextOS Knowledge Manifest v0.5",
  "type": "object",
  "required": [
    "version",
    "source",
    "maps",
    "internal",
    "coverage",
    "incremental",
    "integrity"
  ],
  "properties": {
    "version": {
      "const": "0.5.0"
    },
    "maps": {
      "type": "object",
      "required": [
        "inventory",
        "repo",
        "dependency",
        "symbols",
        "domains_index",
        "domains"
      ]
    },
    "integrity": {
      "type": "object",
      "required": [
        "algorithm",
        "payload_sha256"
      ]
    },
    "internal": {
      "type": "object",
      "required": [
        "parse_cache"
      ]
    },
    "incremental": {
      "type": "object",
      "required": [
        "reparsed_files",
        "reused_parse_entries",
        "added",
        "changed",
        "deleted"
      ]
    }
  }
}
