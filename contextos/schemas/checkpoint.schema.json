{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextOS Checkpoint v0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version","checkpoint_id","task_id","created_at","reason","agent","phase","task",
    "run_state","working_set","summary","decisions","evidence","relevant_tests","risks",
    "open_questions","next","context_metrics","integrity"
  ],
  "properties": {
    "version": { "const": "0.2.0" },
    "checkpoint_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}$" },
    "task_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "reason": { "enum": ["BUDGET_CHECKPOINT","PRE_COMPACTION","PRE_NEW_SESSION","MANUAL"] },
    "agent": { "type": "string", "minLength": 1 },
    "phase": { "type": "string", "minLength": 1 },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective","constraints"],
      "properties": {
        "objective": { "type": "string" },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "run_state": { "type": "object" },
    "working_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_git_repo","head","changed_paths","diff_stat"],
      "properties": {
        "is_git_repo": { "type": "boolean" },
        "head": { "type": ["string","null"] },
        "changed_paths": { "type": "array", "items": { "type": "string" } },
        "diff_stat": { "type": ["string","null"] }
      }
    },
    "summary": { "type": "string" },
    "decisions": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "relevant_tests": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "next": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent","action","required_reads","forbidden_actions"],
      "properties": {
        "agent": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "required_reads": { "type": "array", "items": { "type": "string" } },
        "forbidden_actions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "context_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_profile","used_tokens","pressure_band","transcript_included"],
      "properties": {
        "runtime_profile": { "type": "string" },
        "used_tokens": { "type": ["integer","null"], "minimum": 0 },
        "pressure_band": { "type": ["string","null"] },
        "transcript_included": { "const": false }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm","payload_sha256"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "payload_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
